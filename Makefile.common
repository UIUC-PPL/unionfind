#set the following variables to absolute paths
PARENT_DIR = $(HOME)
CHARM_DIR = $(PARENT_DIR)/charm_reconverse
UNION_FIND_DIR = $(PARENT_DIR)/unionfind
PREFIX_LIB_DIR = $(UNION_FIND_DIR)/prefixLib
HTRAM_LIB_DIR = $(PARENT_DIR)/htram

#charmc options
#ANCHOR= -DANCHOR_ALGO
ANCHOR= 
PROFILE= -DPROFILING
# htram aggregation: DEFAULT OFF (2026-07-27 measurement, 80M at 480 PEs:
# aggregation cost 1-2.4 s of the union-find phase while carrying only 22k
# edges — tram group creation + per-destination buffers scale with PE
# count). Turn on for multi-billion-particle / very-high-edge-count runs:
#   make AGGREGATION=-DAGGREGATION
# ABI: this flag changes unionFindLib.h's class layout; the CLIENT build
# (e.g. paratreet2) must use the SAME setting, and both need make clean.
AGGREGATION =
#for datatype declaration
UNIONFIND= -DUNIONFIND
CHARMC = $(CHARM_DIR)/bin/charmc $(ANCHOR) $(PROFILE) $(UNIONFIND) $(AGGREGATION)
OPTS = -std=c++11 -O3 -g
LD_OPTS =

#options for building union-find library and prefix library
PREFIX_LIBS = -L${PREFIX_LIB_DIR} -lprefix
PREFIX_INC = -I${PREFIX_LIB_DIR}

HTRAM_LIBS = -L${HTRAM_LIB_DIR} -lhtram_group_unionfind
HTRAM_INC = -I${HTRAM_LIB_DIR}

UNION_FIND_LIBS = -L${UNION_FIND_DIR} -lunionFind ${PREFIX_LIBS} ${HTRAM_LIBS}
UNION_FIND_INC = -I${UNION_FIND_DIR} ${PREFIX_INC} ${HTRAM_INC}
