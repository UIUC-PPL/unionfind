module unionFindLib {
    extern module prefixBalance;
#ifdef AGGREGATION
    extern module htram_group; // aggregation only
#endif

    include "types.h";
    // initnode function to register custom reduction
    initnode void register_merge_count_maps_reduction(void);

    readonly CProxy_UnionFindLib _UfLibProxy;
    readonly CProxy_Prefix prefixLibArray;
    readonly CkGroupID libGroupID;

    array[1D] UnionFindLib {
        entry UnionFindLib();

        
        // ready: contributed by every element once wired (see unionFindLib.h)
        entry void passLibGroupID(CkGroupID lgid, CProxy_Prefix pla, CkCallback ready);
        entry void enableLazyMode();


        // function to register Phase 1 callback
        entry void register_phase_one_cb(CkCallback cb);
#ifdef AGGREGATION
        entry void set_tram_proxy(CProxy_HTram proxy); // aggregation only
#endif
        // functions to build inverted trees
        entry void union_request(uint64_t v, uint64_t w);
        // client-facing API addition: batched union requests (one message per PE)
        entry void union_requests(const std::vector<UFEdge>& edges);
#ifndef ANCHOR_ALGO
        entry void find_boss1(uint64_t arrIdx, uint64_t partnerID, uint64_t initID);
        entry void find_boss2(uint64_t arrIdx, uint64_t boss1ID, uint64_t initID);
#else
        entry void anchor(uint64_t w_arrIdx, uint64_t v, long path_base_arrIdx);
#endif
        // function for grandparent short-circuiting
        entry void short_circuit_parent(shortCircuitData scd);

        // function for path compression support
        entry void compress_path(uint64_t arrIdx, uint64_t compressedParent);

        // functions to perform distributed connected components
        entry void find_components(CkCallback cb);
        entry [reductiontarget] void component_count_done(int totalCount);
        entry void need_boss(uint64_t arrIdx, uint64_t fromID);
        entry void add_size(uint64_t arrIdx, long delta);
        entry void set_component(uint64_t arrIdx, int compNum, long compSize);

        // functions to prune out small components
        entry void prune_components(int threshold, CkCallback cb);
        entry [reductiontarget] void perform_pruning();
        entry [reductiontarget] void report_surviving_components(long totalData[numElems], int numElems);
        //entry [reductiontarget,nokeep] void merge_count_results(CkReductionMsg *msg);
        //entry [reductiontarget] void merge_count_results(int totalCounts[numElems], int numElems);

        // flush aggregation buffers
        entry void flush_buffers();
        entry void quiesce(CkCallback cb);

        // TRAM functions
        entry void insertDataFindBoss(const findBossData & data);
        entry void insertDataNeedBoss(const needBossData & data);
        // Batched labeling requests: one message per (source chare,
        // destination chare) pair for the start_component_labeling
        // scatter, instead of one message per requesting vertex.
        entry void insertDataNeedBossBatch(const std::vector<needBossData>& batch);
#ifdef ANCHOR_ALGO
        entry void insertDataAnchor(const anchorData & data);
#endif
#ifdef PROFILING
        entry [reductiontarget] void profiling_count_max(long maxCount);
#endif
    }

    // group chare to support the library chares
    group UnionFindLibGroup {
        entry UnionFindLibGroup();
        entry [reductiontarget] void build_component_count_array(int totalCounts[numElems], int numElems);
        entry [reductiontarget] void done_profiling(int result);
        entry void contribute_count();

    }

    // client-facing API addition: one-element-per-process placement for
    // unionFindInitOnePerNode (element i on the first PE of node i)
    group UFNodeMap : CkArrayMap {
        entry UFNodeMap();
    }
};
